# Copy this file to .env.local and add your credentials.
# Never commit .env.local or expose server-only secrets with NEXT_PUBLIC_.

# ── Film and television charts ──────────────────────────────────────────────
TRAKT_CLIENT_ID=
TMDB_ACCESS_TOKEN=

# IMDb Top 1000 through the selected RapidAPI provider.
RAPIDAPI_KEY=
RAPIDAPI_IMDB_HOST=imdb-top-1000-movies-series.p.rapidapi.com
RAPIDAPI_IMDB_TOP1000_PATH=/list/{page}
RAPIDAPI_IMDB_PAGE_COUNT=100

# Optional rating enrichment for IMDb, Rotten Tomatoes, and Metacritic.
OMDB_API_KEY=

# ── Music ───────────────────────────────────────────────────────────────────
# Rankings come from the locally stored Rolling Stone 500 and worldwide
# ListenBrainz charts. This storefront controls only iTunes catalog matching.
ITUNES_STOREFRONT=US

# Optional Spotify catalog matching; these credentials stay server-side.
# The market is an availability fallback only and does not affect chart ranking.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No credentials required: the stored Letterboxd, Rotten Tomatoes, IMDb,
# Goodreads, Greatest Books, and Rolling Stone snapshots; Jikan, ListenBrainz,
# Open Library, and iTunes Search.
