# Trakt public API app client ID
TRAKT_CLIENT_ID=

# TMDb API Read Access Token (Bearer token, not the shorter v3 API key)
TMDB_ACCESS_TOKEN=

# Exact IMDb Top 250 RapidAPI proxy
RAPIDAPI_KEY=
RAPIDAPI_IMDB_HOST=imdb248.p.rapidapi.com
RAPIDAPI_IMDB_TOP250_PATH=/api/imdb/rankings/top/250

# Optional: enrich the selected title with actual IMDb, RT and Metacritic badges
OMDB_API_KEY=

# Music charts
# ListenBrainz and iTunes metadata work without keys.
LASTFM_API_KEY=
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=us
ITUNES_STOREFRONT=US

# Spotify catalog matching (server-only Client Credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Supabase Auth + Watchlist
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
